# nginx 部署示例（宝塔环境可直接改站点配置）
#
# 站点根目录：    /www/wwwroot/techforge
# 安装包目录：    /www/wwwroot/techforge/downloads/TeachForge-Setup-x64.exe
# 把 apps/website/ 下的文件（除 deploy/）整体放到站点根目录即可。

server {
    listen 80;
    server_name helloyuchen.com.cn www.helloyuchen.com.cn;
    return 301 https://www.helloyuchen.com.cn$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.helloyuchen.com.cn;

    ssl_certificate     /www/server/panel/vhost/cert/helloyuchen.com.cn/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/helloyuchen.com.cn/privkey.pem;

    root  /www/wwwroot/techforge;
    index index.html;
    charset utf-8;

    # 静态站：找不到文件就落到 404.html，不做 history 路由回退
    error_page 404 /404.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # 安装包：强制下载 + 支持断点续传（nginx 默认支持 Range）
    location = /downloads/TeachForge-Setup-x64.exe {
        add_header Content-Disposition "attachment; filename=\"TeachForge-Setup-x64.exe\"";
        add_header X-Content-Type-Options "nosniff";
        # 289 MB：不要放进 gzip 或代理缓冲
        gzip off;
        proxy_buffering off;
        expires 7d;
    }

    # 图片与字体：一年缓存
    location ~* \.(webp|png|ico|woff2)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # HTML 与 CSS：不缓存，保证发版立即生效
    location ~* \.(html|css|xml|txt)$ {
        add_header Cache-Control "no-cache";
    }

    gzip on;
    gzip_min_length 1024;
    gzip_types text/html text/css application/xml application/json image/svg+xml;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header Referrer-Policy "strict-origin-when-cross-origin";
}
