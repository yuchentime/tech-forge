{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2024", "DOM"],
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node", "electron"]
  },
  "include": [
    "electron/**/*.ts",
    "src/types/desktop-bridge.ts",
    "src/features/agent/agent-event-bus.ts",
    "src/features/agent/agent-chat-adapter.ts",
    "src/features/agent/conversation-history.ts",
    "src/features/agent/layout-budget.ts",
    "src/features/agent/tool-activity-label.ts",
    "src/features/agent/turn-progress.ts",
    "src/features/knowledge-profile/knowledge-profile-cards.ts",
    "src/features/rehearsal/rehearsal-api.ts",
    "src/features/rehearsal/rehearsal-availability.ts",
    "src/features/rehearsal/rehearsal-preparing-progress.ts",
    "src/features/rehearsal/rehearsal-store.ts",
    "src/features/agent/search-text-index.ts"
  ]
}
